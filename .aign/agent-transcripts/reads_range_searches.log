{"tool":"exec_command","command":"python3 -c '\nfrom pathlib import Path\nimport re\nspec = {\n    \"conceptualize\": {\n        \"core\": \"conceptualization.md\",\n        \"suffix\": \"conceptualized\",\n        \"core_checks\": [\"Abstract representation, not scope\", \"Concept test\", \"Relationship test\", \"Abstraction test\", \"Conceptual abstraction versus generalization\", \"Final fidelity review\"],\n        \"profile_checks\": [\"Model authority and adoption accurately\", \"Required conceptual distinctions\", \"Required technical distinctions\"],\n    },\n    \"generalize\": {\n        \"core\": \"generalization.md\",\n        \"suffix\": \"generalized\",\n        \"core_checks\": [\"Generalize to the broadest scope justified by evidence, never broader\", \"Analyze each candidate\", \"Generalize by conditions\", \"Overgeneralization test\", \"Final fidelity and scope review\"],\n        \"profile_checks\": [\"Resolve authority and adoption\", \"Required evidence distinctions\", \"Required technical distinctions\"],\n    },\n}\nfor name, checks in spec.items():\n    root = Path(\"skills\") / name\n    expected = {\"SKILL.md\", \"agents/openai.yaml\", \"modes/default.md\", \"modes/combine.md\", \"references/input-output-resolution.md\", \"references/artifact-types.md\", \"references/context-resolution.md\", \"references/corpus-resolution.md\", f\"references/{checks['core']}\", \"references/artifacts/conversation.md\", \"references/artifacts/research.md\", \"references/artifacts/technical.md\"}\n    actual = {p.relative_to(root).as_posix() for p in root.rglob(\"*\") if p.is_file()}\n    assert actual == expected, (name, actual ^ expected)\n    for source in [root / \"SKILL.md\", root / \"modes/default.md\", root / \"modes/combine.md\"]:\n        for target in re.findall(r\"\\]\\(([^)#]+)(?:#[^)]*)?\\)\", source.read_text()):\n            assert (source.parent / target).resolve().exists(), f\"broken: {source} -> {target}\"\n    router = (root / \"SKILL.md\")