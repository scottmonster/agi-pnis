{"tool":"exec_command","command":"python3 - <<'PY'\nfrom pathlib import Path\nimport re\n\nfor version in range(1, 6):\n    path = Path(f'test-runs/mine-vs-resynth-v{version}/rounds/round-001/round-manifest.md')\n    lines = path.read_text().splitlines()\n    header_index = next(i for i, line in enumerate(lines) if line.startswith('|') and 'Mine low' in line and 'Mine medium' in line and 'Mine high' in line)\n    header = [part.strip() for part in lines[header_index].strip('|').split('|')]\n    positions = [header.index('Mine low'), header.index('Mine medium'), header.index('Mine high'), next(i for i, x in enumerate(header) if 'Soft then Mine low' in x), next(i for i, x in enumerate(header) if 'Hard then Mine low' in x)]\n    rows=[]\n    for line in lines[header_index+2:]:\n        if not line.startswith('|'):\n            break\n        cells=[part.strip() for part in line.strip('|').split('|')]\n        label=re.sub(r'[*`]', '', cells[0]).lower()\n        if 'aggregate' in label or label.startswith('all '):\n            continue\n        def number(cell):\n            return int(re.search(r'[0-9][0-9,]*', cell).group().replace(',',''))\n        rows.append([number(cells[i]) for i in positions])\n    med=sum(row[1] for row in rows); high=sum(row[2] for row in rows); soft=sum(row[3] for row in rows); hard=sum(row[4] for row in rows)\n    combined=sum(row[2] < row[1] for row in rows)\n    separate=sum(row[4] < row[3] for row in rows)\n    print(f'v{version}: combined high/medium={high}/{med}, high<medium {combined}/{len(rows)}; separate hard/soft={hard}/{soft}, hard<soft {separate}/{len(rows)}')\nPY\nrg -n -A 8 \"Producer.*mean|Producer variant|Group.*Mean seconds|End-to-end producer elapsed seconds\" test-runs/mine-vs-resynth-v{1,2,3,4,5}/final-report.md","files":["/rounds/round-001/round-manifest.md","final-report.md"],"category":"search"}
