{"tool":"exec_command","command":"cat > scripts/batch_ops/IGM_resize.py <<'PY'\n#!/usr/bin/env python3\n\n\"\"\"\nImage Resize\n============\n\nResize one image file or every image file in a directory with decimal scaling.\nThis script is for regular image files, not FITS conversion.\n\nDefault output:\n  File input:\n    <input_parent>/<script_name>_<original_filename>\n\n  Directory input:\n    <input_dir>/<script_name>/<output_files>\n\n  The script_name is read from this script's filename, so renaming the script\n  automatically changes the default output names. Use --overwrite when\n  output_path differs from input_path and existing output files should be\n  replaced.\n\nScript defaults:\n  --scale|-s scale float 0.5\n  --interp|-i interpolation choice auto\n  --format|-f output format choice preserve\n  --quality webp/jpeg quality int 95\n  (default) supported input formats text png, tif, tiff, jpg, jpeg, webp\n\nExamples:\n  python /home/scott/Documents/siril/scripts/batch_ops/IGM_resize.py /path/to/image.png\n  python /home/scott/Documents/siril/scripts/batch_ops/IGM_resize.py /path/to/image.png --scale 0.5\n  python /home/scott/Documents/siril/scripts/batch_ops/IGM_resize.py /path/to/image.png --format webp\n  python /home/scott/Documents/siril/scripts/batch_ops/IGM_resize.py /path/to/images /path/to/output --recursive --overwrite\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nimport cv2\nimport numpy as np\n\n\nIMAGE_SUFFIXES = (\".png\", \".tif\", \".tiff\", \".jpg\", \".jpeg\", \".webp\")\nOUTPUT_FORMATS = (\"preserve\", \"png\", \"tif\", \"tiff\", \"jpg\", \"jpeg\", \"webp\")\nINTERP_METHODS = (\"auto\", \"area\", \"lanczos4\", \"cubic\", \"linear\", \"nearest\")\n\n\ndef is_image_path(path: Path) -> bool:\n    return path.is_file() and path.suffix.lower() in IMAGE_SUFFIXES\n\n\ndef script_name() -> str:\n    return Path(__file__).stem\n\n\ndef output_extension(src: Path, fmt: str) -> str:\n    if fmt == \"preserve\":\n        return src.suffix.lstrip(\".\").lower()\n    return \"tiff\" if fmt == \"tif\" else fmt\n\n\ndef default_single_output(src: Path, fmt: str) -> Path:\n    return src.with_name(f\"{script_name()}_{src.stem}.{output_extension(src, fmt)}\")\n\n\ndef single_output_path(src: Path, output_path: Path | None, fmt: str) -> Path:\n    if output_path is None:\n        return default_single_output(src, fmt)\n\n    output_path = output_path.expanduser().resolve()\n    if output_path.is_dir():\n        return output_path / default_single_output(src, fmt).name\n    return output_path\n\n\ndef default_dir_output(input_dir: Path) -> Path:\n    return input_dir / script_name()\n\n\ndef output_path_for(src: Path, input_root: Path, output_root: Path, recursive: bool, fmt: str) -> Path:\n    name = f\"{src.stem}.{output_extension(src, fmt)}\"\n    if recursive:\n        return output_root / src.relative_to(input_root).with_name(name)\n    return output_root / name\n\n\ndef iter_image_files(input_dir: Path, recursive: bool) -> list[Path]:\n    iterator = input_dir.rglob(\"*\") if recursive else input_dir.iterdir()\n    return sorted(path for path in iterator if is_image_path(path))\n\n\ndef is_relative_to(path: Path, parent: Path) -> bool:\n    try:\n        path.relative_to(parent)\n        return True\n    except ValueError:\n        return False\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(description=\"Resize image file(s).\")\n    parser.add_argument(\"input_path\", type=Path, help=\"Image file or directory of image files.\")\n    parser.add_argument(\"output_path\", type=Path, nargs=\"?\", help=\"Output image path or output directory.\")\n    parser.add_argument(\"--scale\", \"-s\", type=float, default=0.5, help=\"Decimal resize scale.\")\n    parser.add_argument(\"--interp\", \"-i\", choices=INTERP_METHODS, default=\"auto\", help=\"Resize interpolation.\")\n    parser.add_argument(\"--format\", \"-f\", choices=OUTPUT_FORMATS, default=\"preserve\", help=\"Output image format.\")\n    parser.add_argument(\"--quality\", type=int, default=95, help=\"JPEG/WebP quality, 1-100.\")\n    parser.add_argument(\"--overwrite\", action=\"store_true\", help=\"Allow replacing existing output files.\")\n    parser.add_argument(\"--recursive\", \"-r\", action=\"store_true\", help=\"Process subdirectories too.\")\n    return parser\n\n\ndef cv2_interpolation(name: str, scale: float) -> int:\n    if name == \"auto\":\n        name = \"area\" if scale < 1.0 else \"lanczos4\"\n    return {\n        \"area\": cv2.INTER_AREA,\n        \"lanczos4\": cv2.INTER_LANCZOS4,\n        \"cubic\": cv2.INTER_CUBIC,\n        \"linear\": cv2.INTER_LINEAR,\n        \"nearest\": cv2.INTER_NEAREST,\n    }[name]\n\n\ndef scaled_size(height: int, width: int, scale: float) -> tuple[int, int]:\n    return max(1, int(round(height * scale))), max(1, int(round(width * scale)))\n\n\ndef save_image(dst: Path, image: np.ndarray, fmt: str, quality: int) -> None:\n    actual_fmt = dst.suffix.lower().lstrip(\".\") if fmt == \"preserve\" else fmt\n    params = []\n    if actual_fmt in (\"jpg\", \"jpeg\"):\n        params = [cv2.IMWRITE_JPEG_QUALITY, int(np.clip(quality, 1, 100))]\n    elif actual_fmt == \"webp\":\n        params = [cv2.IMWRITE_WEBP_QUALITY, int(np.clip(quality, 1, 100))]\n\n    dst.parent.mkdir(parents=True, exist_ok=True)\n    ok = cv2.imwrite(str(dst), image, params)\n    if not ok:\n        raise RuntimeError(f\"OpenCV failed to write {dst}; this build may not support {actual_fmt}\")\n\n\ndef process_file(src: Path, dst: Path, args: argparse.Namespace) -> bool:\n    if dst.exists() and not args.overwrite:\n        print(f\"SKIP {src}: {dst} already exists\")\n        return False\n\n    image = cv2.imread(str(src), cv2.IMREAD_UNCHANGED)\n    if image is None:\n        raise ValueError(f\"Could not read image: {src}\")\n\n    new_h, new_w = scaled_size(image.shape[0], image.shape[1], args.scale)\n    resized = cv2.resize(image, (new_w, new_h), interpolation=cv2_interpolation(args.interp, args.scale))\n    save_image(dst, resized, args.format, args.quality)\n    print(f\"{src} -> {dst} ({image.shape[1]}x{image.shape[0]} -> {new_w}x{new_h})\")\n    return True\n\n\ndef collect_jobs(args: argparse.Namespace) -> list[tuple[Path, Path]]:\n    input_path = args.input_path.expanduser().resolve()\n    if input_path.is_file():\n        if not is_image_path(input_path):\n            raise SystemExit(f\"Input file is not a supported image file: {input_path}\")\n        return [(input_path, single_output_path(input_path, args.output_path, args.format))]\n\n    if input_path.is_dir():\n        output_root = (\n            args.output_path.expanduser().resolve()\n            if args.output_path is not None\n            else default_dir_output(input_path)\n        )\n        src_files = iter_image_files(input_path, args.recursive)\n        if output_root != input_path:\n            src_files = [src for src in src_files if not is_relative_to(src, output_root)]\n        if not src_files:\n            raise SystemExit(f\"No supported image files found in {input_path}\")\n        return [\n            (src, output_path_for(src, input_path, output_root, args.recursive, args.format))\n            for src in src_files\n        ]\n\n    raise SystemExit(f\"Input path not found: {input_path}\")\n\n\ndef main() -> int:\n    parser = build_parser()\n    args = parser.parse_args()\n\n    if args.scale <= 0:\n        raise SystemExit(\"--scale must be greater than 0\")\n\n    jobs = collect_jobs(args)\n    ok = 0\n    failed = 0\n    skipped = 0\n    for src, dst in jobs:\n        try:\n            if process_file(src, dst, args):\n                ok += 1\n            else:\n                skipped += 1\n        except Exception as exc:\n            failed += 1\n            print(f\"FAILED {src}: {type(exc).__name__}: {exc}\")\n\n    print(f\"Image resize done: {ok} processed, {skipped} skipped, {failed} failed.\")\n    return 0 if failed == 0 else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\nPY\ncat > scripts/batch_ops/FITS2IMG.py <<'PY'\n#!/usr/bin/env python3\n\n\"\"\"\nFITS to Image Export\n====================\n\nExport one FITS file or every FITS file in a directory to PNG, TIFF, or WebP.\nAutostretch is optional and disabled by default.\n\nDefault output:\n  File input:\n    <input_parent>/<script_name>_<original_stem>.<format>\n\n  Directory input:\n    <input_dir>/<script_name>/<output_files>.<format>\n\n  The script_name is read from this script's filename, so renaming the script\n  automatically changes the default output names. Use --overwrite when\n  output_path differs from input_path and existing output files should be\n  replaced.\n\nScript defaults:\n  --format|-f output format choice png\n  --bit-depth output bit depth choice 16\n  --autostretch autostretch flag false\n  --linked linked autostretch flag false\n  --quality webp quality int 95\n  (default) unstretched mapping text integer dtype range; float clipped 0..1\n\nExamples:\n  python /home/scott/Documents/siril/scripts/batch_ops/FITS2IMG.py /path/to/image.fit\n  python /home/scott/Documents/siril/scripts/batch_ops/FITS2IMG.py /path/to/image.fit --autostretch\n  python /home/scott/Documents/siril/scripts/batch_ops/FITS2IMG.py /path/to/image.fit --format tiff --bit-depth 16\n  python /home/scott/Documents/siril/scripts/batch_ops/FITS2IMG.py /path/to/images --format webp --recursive\n  python /home/scott/Documents/siril/scripts/batch_ops/FITS2IMG.py /path/to/images /path/to/output --overwrite\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nimport cv2\nimport numpy as np\nfrom astropy.io import fits\n\n\nFITS_SUFFIXES = (\".fit\", \".fits\", \".fts\", \".fit.fz\", \".fits.fz\", \".fts.fz\")\nOUTPUT_FORMATS = (\"png\", \"tif\", \"tiff\", \"webp\")\n\n\ndef is_fits_path(path: Path) -> bool:\n    name = path.name.lower()\n    return path.is_file() and any(name.endswith(suffix) for suffix in FITS_SUFFIXES)\n\n\ndef strip_fits_suffix(path: Path) -> str:\n    lower = path.name.lower()\n    for suffix in FITS_SUFFIXES:\n        if lower.endswith(suffix):\n            return path.name[:-len(suffix)]\n    return path.stem\n\n\ndef script_name() -> str:\n    return Path(__file__).stem\n\n\ndef output_extension(fmt: str) -> str:\n    return \"tiff\" if fmt == \"tif\" else fmt\n\n\ndef default_single_output(src: Path, fmt: str) -> Path:\n    return src.with_name(f\"{script_name()}_{strip_fits_suffix(src)}.{output_extension(fmt)}\")\n\n\ndef single_output_path(src: Path, output_path: Path | None, fmt: str) -> Path:\n    if output_path is None:\n        return default_single_output(src, fmt)\n\n    output_path = output_path.expanduser().resolve()\n    if output_path.is_dir():\n        return output_path / default_single_output(src, fmt).name\n    return output_path\n\n\ndef default_dir_output(input_dir: Path) -> Path:\n    return input_dir / script_name()\n\n\ndef output_path_for(src: Path, input_root: Path, output_root: Path, recursive: bool, fmt: str) -> Path:\n    name = f\"{strip_fits_suffix(src)}.{output_extension(fmt)}\"\n    if recursive:\n        return output_root / src.relative_to(input_root).with_name(name)\n    return output_root / name\n\n\ndef iter_fits_files(input_dir: Path, recursive: bool) -> list[Path]:\n    iterator = input_dir.rglob(\"*\") if recursive else input_dir.iterdir()\n    return sorted(path for path in iterator if is_fits_path(path))\n\n\ndef is_relative_to(path: Path, parent: Path) -> bool:\n    try:\n        path.relative_to(parent)\n        return True\n    except ValueError:\n        return False\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(description=\"Export FITS image(s) to PNG, TIFF, or WebP.\")\n    parser.add_argument(\"input_path\", type=Path, help=\"FITS file or directory of FITS files.\")\n    parser.add_argument(\"output_path\", type=Path, nargs=\"?\", help=\"Output image path or output directory.\")\n    parser.add_argument(\"--format\", \"-f\", choices=OUTPUT_FORMATS, default=\"png\", help=\"Output image format.\")\n    parser.add_argument(\"--bit-depth\", choices=(\"8\", \"16\"), default=\"16\", help=\"PNG/TIFF output bit depth.\")\n    parser.add_argument(\"--autostretch\", action=\"store_true\", help=\"Apply local autostretch before export.\")\n    mode = parser.add_mutually_exclusive_group()\n    mode.add_argument(\"--linked\", \"-l\", action=\"store_true\", help=\"Use linked-channel autostretch.\")\n    mode.add_argument(\"--unlinked\", \"-u\", action=\"store_true\", help=\"Use unlinked-channel autostretch.\")\n    parser.add_argument(\"--quality\", type=int, default=95, help=\"WebP quality, 1-100.\")\n    parser.add_argument(\"--overwrite\", action=\"store_true\", help=\"Allow replacing existing output files.\")\n    parser.add_argument(\"--recursive\", \"-r\", action=\"store_true\", help=\"Process subdirectories too.\")\n    return parser\n\n\ndef orient_image(data: np.ndarray) -> np.ndarray:\n    arr = np.asarray(data)\n    if arr.ndim == 2:\n        return arr\n    if arr.ndim == 3 and arr.shape[0] == 3:\n        return np.moveaxis(arr, 0, -1)\n    if arr.ndim == 3 and arr.shape[-1] in (3, 4):\n        return arr\n    raise ValueError(f\"Unsupported FITS image shape for export: {arr.shape}\")\n\n\ndef robust_limits(a: np.ndarray) -> tuple[float, float]:\n    arr = np.asarray(a, dtype=np.float64)\n    finite = arr[np.isfinite(arr)]\n    if finite.size == 0:\n        return 0.0, 1.0\n\n    median = float(np.median(finite))\n    mad = float(np.median(np.abs(finite - median)))\n    sigma = 1.4826 * mad\n    black = median - 2.8 * sigma\n    white = float(np.percentile(finite, 99.8))\n    if not np.isfinite(black):\n        black = float(np.percentile(finite, 0.1))\n    if not np.isfinite(white) or white <= black:\n        black = float(np.min(finite))\n        white = float(np.max(finite))\n    if white <= black:\n        white = black + 1.0\n    return black, white\n\n\ndef scale_to_unit(a: np.ndarray, black: float, white: float) -> np.ndarray:\n    return np.clip((np.asarray(a, dtype=np.float64) - black) / (white - black), 0.0, 1.0)\n\n\ndef autostretch_unit(image: np.ndarray, linked: bool) -> np.ndarray:\n    arr = np.asarray(image)\n    if arr.ndim == 2 or linked:\n        black, white = robust_limits(arr)\n        return scale_to_unit(arr, black, white)\n\n    channels = []\n    for idx in range(arr.shape[-1]):\n        black, white = robust_limits(arr[..., idx])\n        channels.append(scale_to_unit(arr[..., idx], black, white))\n    return np.stack(channels, axis=-1)\n\n\ndef unstretched_unit(image: np.ndarray) -> np.ndarray:\n    arr = np.asarray(image)\n    if np.issubdtype(arr.dtype, np.integer):\n        info = np.iinfo(arr.dtype)\n        return np.clip((arr.astype(np.float64) - info.min) / (info.max - info.min), 0.0, 1.0)\n    return np.clip(arr.astype(np.float64), 0.0, 1.0)\n\n\ndef to_export_array(image: np.ndarray, fmt: str, bit_depth: str, autostretch: bool, linked: bool) -> np.ndarray:\n    unit = autostretch_unit(image, linked) if autostretch else unstretched_unit(image)\n    if fmt == \"webp\" or bit_depth == \"8\":\n        out = np.rint(unit * 255.0).astype(np.uint8)\n    else:\n        out = np.rint(unit * 65535.0).astype(np.uint16)\n\n    if out.ndim == 3 and out.shape[-1] >= 3:\n        if out.shape[-1] == 3:\n            out = cv2.cvtColor(out, cv2.COLOR_RGB2BGR)\n        elif out.shape[-1] == 4:\n            out = cv2.cvtColor(out, cv2.COLOR_RGBA2BGRA)\n    return out\n\n\ndef save_image(dst: Path, image: np.ndarray, fmt: str, quality: int) -> None:\n    params = []\n    if fmt == \"webp\":\n        params = [cv2.IMWRITE_WEBP_QUALITY, int(np.clip(quality, 1, 100))]\n    dst.parent.mkdir(parents=True, exist_ok=True)\n    ok = cv2.imwrite(str(dst), image, params)\n    if not ok:\n        raise RuntimeError(f\"OpenCV failed to write {dst}; this build may not support {fmt}\")\n\n\ndef process_file(src: Path, dst: Path, args: argparse.Namespace) -> bool:\n    if dst.exists() and not args.overwrite:\n        print(f\"SKIP {src}: {dst} already exists\")\n        return False\n\n    image = orient_image(fits.getdata(src))\n    linked = bool(args.linked)\n    export = to_export_array(image, args.format, args.bit_depth, args.autostretch, linked)\n    save_image(dst, export, args.format, args.quality)\n    print(f\"{src} -> {dst} ({args.format}, autostretch={args.autostretch}, linked={linked})\")\n    return True\n\n\ndef collect_jobs(args: argparse.Namespace) -> list[tuple[Path, Path]]:\n    input_path = args.input_path.expanduser().resolve()\n    fmt = args.format\n    if input_path.is_file():\n        if not is_fits_path(input_path):\n            raise SystemExit(f\"Input file is not a FITS file: {input_path}\")\n        return [(input_path, single_output_path(input_path, args.output_path, fmt))]\n\n    if input_path.is_dir():\n        output_root = (\n            args.output_path.expanduser().resolve()\n            if args.output_path is not None\n            else default_dir_output(input_path)\n        )\n        src_files = iter_fits_files(input_path, args.recursive)\n        if output_root != input_path:\n            src_files = [src for src in src_files if not is_relative_to(src, output_root)]\n        if not src_files:\n            raise SystemExit(f\"No FITS files found in {input_path}\")\n        return [\n            (src, output_path_for(src, input_path, output_root, args.recursive, fmt))\n            for src in src_files\n        ]\n\n    raise SystemExit(f\"Input path not found: {input_path}\")\n\n\ndef main() -> int:\n    parser = build_parser()\n    args = parser.parse_args()\n\n    jobs = collect_jobs(args)\n    ok = 0\n    failed = 0\n    skipped = 0\n    for src, dst in jobs:\n        try:\n            if process_file(src, dst, args):\n                ok += 1\n            else:\n                skipped += 1\n        except Exception as exc:\n            failed += 1\n            print(f\"FAILED {src}: {type(exc).__name__}: {exc}\")\n\n    print(f\"FITS to image done: {ok} processed, {skipped} skipped, {failed} failed.\")\n    return 0 if failed == 0 else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\nPY","files":["/home/scott/Documents/siril/scripts/batch_ops/FITS2IMG.py","/home/scott/Documents/siril/scripts/batch_ops/IGM_resize.py","arr.sh","image.sh","out.sh","scripts/batch_ops/FITS2IMG.py","scripts/batch_ops/IGM_resize.py"],"category":"read"}
{"tool":"exec_command","command":"cat > scripts/batch_ops/IGM_resize.py <<'PY'\n#!/usr/bin/env python3\n\n\"\"\"\nImage Resize\n============\n\nResize one image file or every image file in a directory with decimal scaling.\nThis script is for regular image files, not FITS conversion.\n\nDefault output:\n  File input:\n    <input_parent>/<script_name>_<original_filename>\n\n  Directory input:\n    <input_dir>/<script_name>/<output_files>\n\n  The script_name is read from this script's filename, so renaming the script\n  automatically changes the default output names. Use --overwrite when\n  output_path differs from input_path and existing output files should be\n  replaced.\n\nScript defaults:\n  --scale|-s scale float 0.5\n  --interp|-i interpolation choice auto\n  --format|-f output format choice preserve\n  --quality webp/jpeg quality int 95\n  (default) supported input formats text png, tif, tiff, jpg, jpeg, webp\n\nExamples:\n  python /home/scott/Documents/siril/scripts/batch_ops/IGM_resize.py /path/to/image.png\n  python /home/scott/Documents/siril/scripts/batch_ops/IGM_resize.py /path/to/image.png --scale 0.5\n  python /home/scott/Documents/siril/scripts/batch_ops/IGM_resize.py /path/to/image.png --format webp\n  python /home/scott/Documents/siril/scripts/batch_ops/IGM_resize.py /path/to/images /path/to/output --recursive --overwrite\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nimport cv2\nimport numpy as np\n\n\nIMAGE_SUFFIXES = (\".png\", \".tif\", \".tiff\", \".jpg\", \".jpeg\", \".webp\")\nOUTPUT_FORMATS = (\"preserve\", \"png\", \"tif\", \"tiff\", \"jpg\", \"jpeg\", \"webp\")\nINTERP_METHODS = (\"auto\", \"area\", \"lanczos4\", \"cubic\", \"linear\", \"nearest\")\n\n\ndef is_image_path(path: Path) -> bool:\n    return path.is_file() and path.suffix.lower() in IMAGE_SUFFIXES\n\n\ndef script_name() -> str:\n    return Path(__file__).stem\n\n\ndef output_extension(src: Path, fmt: str) -> str:\n    if fmt == \"preserve\":\n        return src.suffix.lstrip(\".\").lower()\n    return \"tiff\" if fmt == \"tif\" else fmt\n\n\ndef default_single_output(src: Path, fmt: str) -> Path:\n    return src.with_name(f\"{script_name()}_{src.stem}.{output_extension(src, fmt)}\")\n\n\ndef single_output_path(src: Path, output_path: Path | None, fmt: str) -> Path:\n    if output_path is None:\n        return default_single_output(src, fmt)\n\n    output_path = output_path.expanduser().resolve()\n    if output_path.is_dir():\n        return output_path / default_single_output(src, fmt).name\n    return output_path\n\n\ndef default_dir_output(input_dir: Path) -> Path:\n    return input_dir / script_name()\n\n\ndef output_path_for(src: Path, input_root: Path, output_root: Path, recursive: bool, fmt: str) -> Path:\n    name = f\"{src.stem}.{output_extension(src, fmt)}\"\n    if recursive:\n        return output_root / src.relative_to(input_root).with_name(name)\n    return output_root / name\n\n\ndef iter_image_files(input_dir: Path, recursive: bool) -> list[Path]:\n    iterator = input_dir.rglob(\"*\") if recursive else input_dir.iterdir()\n    return sorted(path for path in iterator if is_image_path(path))\n\n\ndef is_relative_to(path: Path, parent: Path) -> bool:\n    try:\n        path.relative_to(parent)\n        return True\n    except ValueError:\n        return False\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(description=\"Resize image file(s).\")\n    parser.add_argument(\"input_path\", type=Path, help=\"Image file or directory of image files.\")\n    parser.add_argument(\"output_path\", type=Path, nargs=\"?\", help=\"Output image path or output directory.\")\n    parser.add_argument(\"--scale\", \"-s\", type=float, default=0.5, help=\"Decimal resize scale.\")\n    parser.add_argument(\"--interp\", \"-i\", choices=INTERP_METHODS, default=\"auto\", help=\"Resize interpolation.\")\n    parser.add_argument(\"--format\", \"-f\", choices=OUTPUT_FORMATS, default=\"preserve\", help=\"Output image format.\")\n    parser.add_argument(\"--quality\", type=int, default=95, help=\"JPEG/WebP quality, 1-100.\")\n    parser.add_argument(\"--overwrite\", action=\"store_true\", help=\"Allow replacing existing output files.\")\n    parser.add_argument(\"--recursive\", \"-r\", action=\"store_true\", help=\"Process subdirectories too.\")\n    return parser\n\n\ndef cv2_interpolation(name: str, scale: float) -> int:\n    if name == \"auto\":\n        name = \"area\" if scale < 1.0 else \"lanczos4\"\n    return {\n        \"area\": cv2.INTER_AREA,\n        \"lanczos4\": cv2.INTER_LANCZOS4,\n        \"cubic\": cv2.INTER_CUBIC,\n        \"linear\": cv2.INTER_LINEAR,\n        \"nearest\": cv2.INTER_NEAREST,\n    }[name]\n\n\ndef scaled_size(height: int, width: int, scale: float) -> tuple[int, int]:\n    return max(1, int(round(height * scale))), max(1, int(round(width * scale)))\n\n\ndef save_image(dst: Path, image: np.ndarray, fmt: str, quality: int) -> None:\n    actual_fmt = dst.suffix.lower().lstrip(\".\") if fmt == \"preserve\" else fmt\n    params = []\n    if actual_fmt in (\"jpg\", \"jpeg\"):\n        params = [cv2.IMWRITE_JPEG_QUALITY, int(np.clip(quality, 1, 100))]\n    elif actual_fmt == \"webp\":\n        params = [cv2.IMWRITE_WEBP_QUALITY, int(np.clip(quality, 1, 100))]\n\n    dst.parent.mkdir(parents=True, exist_ok=True)\n    ok = cv2.imwrite(str(dst), image, params)\n    if not ok:\n        raise RuntimeError(f\"OpenCV failed to write {dst}; this build may not support {actual_fmt}\")\n\n\ndef process_file(src: Path, dst: Path, args: argparse.Namespace) -> bool:\n    if dst.exists() and not args.overwrite:\n        print(f\"SKIP {src}: {dst} already exists\")\n        return False\n\n    image = cv2.imread(str(src), cv2.IMREAD_UNCHANGED)\n    if image is None:\n        raise ValueError(f\"Could not read image: {src}\")\n\n    new_h, new_w = scaled_size(image.shape[0], image.shape[1], args.scale)\n    resized = cv2.resize(image, (new_w, new_h), interpolation=cv2_interpolation(args.interp, args.scale))\n    save_image(dst, resized, args.format, args.quality)\n    print(f\"{src} -> {dst} ({image.shape[1]}x{image.shape[0]} -> {new_w}x{new_h})\")\n    return True\n\n\ndef collect_jobs(args: argparse.Namespace) -> list[tuple[Path, Path]]:\n    input_path = args.input_path.expanduser().resolve()\n    if input_path.is_file():\n        if not is_image_path(input_path):\n            raise SystemExit(f\"Input file is not a supported image file: {input_path}\")\n        return [(input_path, single_output_path(input_path, args.output_path, args.format))]\n\n    if input_path.is_dir():\n        output_root = (\n            args.output_path.expanduser().resolve()\n            if args.output_path is not None\n            else default_dir_output(input_path)\n        )\n        src_files = iter_image_files(input_path, args.recursive)\n        if output_root != input_path:\n            src_files = [src for src in src_files if not is_relative_to(src, output_root)]\n        if not src_files:\n            raise SystemExit(f\"No supported image files found in {input_path}\")\n        return [\n            (src, output_path_for(src, input_path, output_root, args.recursive, args.format))\n            for src in src_files\n        ]\n\n    raise SystemExit(f\"Input path not found: {input_path}\")\n\n\ndef main() -> int:\n    parser = build_parser()\n    args = parser.parse_args()\n\n    if args.scale <= 0:\n        raise SystemExit(\"--scale must be greater than 0\")\n\n    jobs = collect_jobs(args)\n    ok = 0\n    failed = 0\n    skipped = 0\n    for src, dst in jobs:\n        try:\n            if process_file(src, dst, args):\n                ok += 1\n            else:\n                skipped += 1\n        except Exception as exc:\n            failed += 1\n            print(f\"FAILED {src}: {type(exc).__name__}: {exc}\")\n\n    print(f\"Image resize done: {ok} processed, {skipped} skipped, {failed} failed.\")\n    return 0 if failed == 0 else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\nPY\ncat > scripts/batch_ops/FITS2IMG.py <<'PY'\n#!/usr/bin/env python3\n\n\"\"\"\nFITS to Image Export\n====================\n\nExport one FITS file or every FITS file in a directory to PNG, TIFF, or WebP.\nAutostretch is optional and disabled by default.\n\nDefault output:\n  File input:\n    <input_parent>/<script_name>_<original_stem>.<format>\n\n  Directory input:\n    <input_dir>/<script_name>/<output_files>.<format>\n\n  The script_name is read from this script's filename, so renaming the script\n  automatically changes the default output names. Use --overwrite when\n  output_path differs from input_path and existing output files should be\n  replaced.\n\nScript defaults:\n  --format|-f output format choice png\n  --bit-depth output bit depth choice 16\n  --autostretch autostretch flag false\n  --linked linked autostretch flag false\n  --quality webp quality int 95\n  (default) unstretched mapping text integer dtype range; float clipped 0..1\n\nExamples:\n  python /home/scott/Documents/siril/scripts/batch_ops/FITS2IMG.py /path/to/image.fit\n  python /home/scott/Documents/siril/scripts/batch_ops/FITS2IMG.py /path/to/image.fit --autostretch\n  python /home/scott/Documents/siril/scripts/batch_ops/FITS2IMG.py /path/to/image.fit --format tiff --bit-depth 16\n  python /home/scott/Documents/siril/scripts/batch_ops/FITS2IMG.py /path/to/images --format webp --recursive\n  python /home/scott/Documents/siril/scripts/batch_ops/FITS2IMG.py /path/to/images /path/to/output --overwrite\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\n\nimport cv2\nimport numpy as np\nfrom astropy.io import fits\n\n\nFITS_SUFFIXES = (\".fit\", \".fits\", \".fts\", \".fit.fz\", \".fits.fz\", \".fts.fz\")\nOUTPUT_FORMATS = (\"png\", \"tif\", \"tiff\", \"webp\")\n\n\ndef is_fits_path(path: Path) -> bool:\n    name = path.name.lower()\n    return path.is_file() and any(name.endswith(suffix) for suffix in FITS_SUFFIXES)\n\n\ndef strip_fits_suffix(path: Path) -> str:\n    lower = path.name.lower()\n    for suffix in FITS_SUFFIXES:\n        if lower.endswith(suffix):\n            return path.name[:-len(suffix)]\n    return path.stem\n\n\ndef script_name() -> str:\n    return Path(__file__).stem\n\n\ndef output_extension(fmt: str) -> str:\n    return \"tiff\" if fmt == \"tif\" else fmt\n\n\ndef default_single_output(src: Path, fmt: str) -> Path:\n    return src.with_name(f\"{script_name()}_{strip_fits_suffix(src)}.{output_extension(fmt)}\")\n\n\ndef single_output_path(src: Path, output_path: Path | None, fmt: str) -> Path:\n    if output_path is None:\n        return default_single_output(src, fmt)\n\n    output_path = output_path.expanduser().resolve()\n    if output_path.is_dir():\n        return output_path / default_single_output(src, fmt).name\n    return output_path\n\n\ndef default_dir_output(input_dir: Path) -> Path:\n    return input_dir / script_name()\n\n\ndef output_path_for(src: Path, input_root: Path, output_root: Path, recursive: bool, fmt: str) -> Path:\n    name = f\"{strip_fits_suffix(src)}.{output_extension(fmt)}\"\n    if recursive:\n        return output_root / src.relative_to(input_root).with_name(name)\n    return output_root / name\n\n\ndef iter_fits_files(input_dir: Path, recursive: bool) -> list[Path]:\n    iterator = input_dir.rglob(\"*\") if recursive else input_dir.iterdir()\n    return sorted(path for path in iterator if is_fits_path(path))\n\n\ndef is_relative_to(path: Path, parent: Path) -> bool:\n    try:\n        path.relative_to(parent)\n        return True\n    except ValueError:\n        return False\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(description=\"Export FITS image(s) to PNG, TIFF, or WebP.\")\n    parser.add_argument(\"input_path\", type=Path, help=\"FITS file or directory of FITS files.\")\n    parser.add_argument(\"output_path\", type=Path, nargs=\"?\", help=\"Output image path or output directory.\")\n    parser.add_argument(\"--format\", \"-f\", choices=OUTPUT_FORMATS, default=\"png\", help=\"Output image format.\")\n    parser.add_argument(\"--bit-depth\", choices=(\"8\", \"16\"), default=\"16\", help=\"PNG/TIFF output bit depth.\")\n    parser.add_argument(\"--autostretch\", action=\"store_true\", help=\"Apply local autostretch before export.\")\n    mode = parser.add_mutually_exclusive_group()\n    mode.add_argument(\"--linked\", \"-l\", action=\"store_true\", help=\"Use linked-channel autostretch.\")\n    mode.add_argument(\"--unlinked\", \"-u\", action=\"store_true\", help=\"Use unlinked-channel autostretch.\")\n    parser.add_argument(\"--quality\", type=int, default=95, help=\"WebP quality, 1-100.\")\n    parser.add_argument(\"--overwrite\", action=\"store_true\", help=\"Allow replacing existing output files.\")\n    parser.add_argument(\"--recursive\", \"-r\", action=\"store_true\", help=\"Process subdirectories too.\")\n    return parser\n\n\ndef orient_image(data: np.ndarray) -> np.ndarray:\n    arr = np.asarray(data)\n    if arr.ndim == 2:\n        return arr\n    if arr.ndim == 3 and arr.shape[0] == 3:\n        return np.moveaxis(arr, 0, -1)\n    if arr.ndim == 3 and arr.shape[-1] in (3, 4):\n        return arr\n    raise ValueError(f\"Unsupported FITS image shape for export: {arr.shape}\")\n\n\ndef robust_limits(a: np.ndarray) -> tuple[float, float]:\n    arr = np.asarray(a, dtype=np.float64)\n    finite = arr[np.isfinite(arr)]\n    if finite.size == 0:\n        return 0.0, 1.0\n\n    median = float(np.median(finite))\n    mad = float(np.median(np.abs(finite - median)))\n    sigma = 1.4826 * mad\n    black = median - 2.8 * sigma\n    white = float(np.percentile(finite, 99.8))\n    if not np.isfinite(black):\n        black = float(np.percentile(finite, 0.1))\n    if not np.isfinite(white) or white <= black:\n        black = float(np.min(finite))\n        white = float(np.max(finite))\n    if white <= black:\n        white = black + 1.0\n    return black, white\n\n\ndef scale_to_unit(a: np.ndarray, black: float, white: float) -> np.ndarray:\n    return np.clip((np.asarray(a, dtype=np.float64) - black) / (white - black), 0.0, 1.0)\n\n\ndef autostretch_unit(image: np.ndarray, linked: bool) -> np.ndarray:\n    arr = np.asarray(image)\n    if arr.ndim == 2 or linked:\n        black, white = robust_limits(arr)\n        return scale_to_unit(arr, black, white)\n\n    channels = []\n    for idx in range(arr.shape[-1]):\n        black, white = robust_limits(arr[..., idx])\n        channels.append(scale_to_unit(arr[..., idx], black, white))\n    return np.stack(channels, axis=-1)\n\n\ndef unstretched_unit(image: np.ndarray) -> np.ndarray:\n    arr = np.asarray(image)\n    if np.issubdtype(arr.dtype, np.integer):\n        info = np.iinfo(arr.dtype)\n        return np.clip((arr.astype(np.float64) - info.min) / (info.max - info.min), 0.0, 1.0)\n    return np.clip(arr.astype(np.float64), 0.0, 1.0)\n\n\ndef to_export_array(image: np.ndarray, fmt: str, bit_depth: str, autostretch: bool, linked: bool) -> np.ndarray:\n    unit = autostretch_unit(image, linked) if autostretch else unstretched_unit(image)\n    if fmt == \"webp\" or bit_depth == \"8\":\n        out = np.rint(unit * 255.0).astype(np.uint8)\n    else:\n        out = np.rint(unit * 65535.0).astype(np.uint16)\n\n    if out.ndim == 3 and out.shape[-1] >= 3:\n        if out.shape[-1] == 3:\n            out = cv2.cvtColor(out, cv2.COLOR_RGB2BGR)\n        elif out.shape[-1] == 4:\n            out = cv2.cvtColor(out, cv2.COLOR_RGBA2BGRA)\n    return out\n\n\ndef save_image(dst: Path, image: np.ndarray, fmt: str, quality: int) -> None:\n    params = []\n    if fmt == \"webp\":\n        params = [cv2.IMWRITE_WEBP_QUALITY, int(np.clip(quality, 1, 100))]\n    dst.parent.mkdir(parents=True, exist_ok=True)\n    ok = cv2.imwrite(str(dst), image, params)\n    if not ok:\n        raise RuntimeError(f\"OpenCV failed to write {dst}; this build may not support {fmt}\")\n\n\ndef process_file(src: Path, dst: Path, args: argparse.Namespace) -> bool:\n    if dst.exists() and not args.overwrite:\n        print(f\"SKIP {src}: {dst} already exists\")\n        return False\n\n    image = orient_image(fits.getdata(src))\n    linked = bool(args.linked)\n    export = to_export_array(image, args.format, args.bit_depth, args.autostretch, linked)\n    save_image(dst, export, args.format, args.quality)\n    print(f\"{src} -> {dst} ({args.format}, autostretch={args.autostretch}, linked={linked})\")\n    return True\n\n\ndef collect_jobs(args: argparse.Namespace) -> list[tuple[Path, Path]]:\n    input_path = args.input_path.expanduser().resolve()\n    fmt = args.format\n    if input_path.is_file():\n        if not is_fits_path(input_path):\n            raise SystemExit(f\"Input file is not a FITS file: {input_path}\")\n        return [(input_path, single_output_path(input_path, args.output_path, fmt))]\n\n    if input_path.is_dir():\n        output_root = (\n            args.output_path.expanduser().resolve()\n            if args.output_path is not None\n            else default_dir_output(input_path)\n        )\n        src_files = iter_fits_files(input_path, args.recursive)\n        if output_root != input_path:\n            src_files = [src for src in src_files if not is_relative_to(src, output_root)]\n        if not src_files:\n            raise SystemExit(f\"No FITS files found in {input_path}\")\n        return [\n            (src, output_path_for(src, input_path, output_root, args.recursive, fmt))\n            for src in src_files\n        ]\n\n    raise SystemExit(f\"Input path not found: {input_path}\")\n\n\ndef main() -> int:\n    parser = build_parser()\n    args = parser.parse_args()\n\n    jobs = collect_jobs(args)\n    ok = 0\n    failed = 0\n    skipped = 0\n    for src, dst in jobs:\n        try:\n            if process_file(src, dst, args):\n                ok += 1\n            else:\n                skipped += 1\n        except Exception as exc:\n            failed += 1\n            print(f\"FAILED {src}: {type(exc).__name__}: {exc}\")\n\n    print(f\"FITS to image done: {ok} processed, {skipped} skipped, {failed} failed.\")\n    return 0 if failed == 0 else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\nPY","files":["/home/scott/Documents/siril/scripts/batch_ops/FITS2IMG.py","/home/scott/Documents/siril/scripts/batch_ops/IGM_resize.py","arr.sh","image.sh","out.sh","scripts/batch_ops/FITS2IMG.py","scripts/batch_ops/IGM_resize.py"],"category":"read"}
