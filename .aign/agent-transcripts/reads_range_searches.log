nvm.runInNewContext(script, context);\n(async () => {\n  const initialDelay = timers.shift();\n  if (initialDelay.delay !== 5000) throw new Error('Expected initial placeholder delay.');\n  await initialDelay.callback();\n  for (let i = 0; i < 12; i += 1) await new Promise(setImmediate);\n  if (!images['random-gif'].currentSrc.startsWith('blob:')) throw new Error('Current GIF was not supplied from a preloaded blob.');\n  if (!fetched.includes('bamboozled.gif')) throw new Error('Next GIF was not preloaded while the current GIF played.');\n  const loopTimer = timers.shift();\n  if (loopTimer.delay !== 4210) throw new Error(`Expected first Gotcha loop timer, got ${loopTimer.delay}.`);\n  await loopTimer.callback();\n  const transitionTimer = timers.shift();\n  if (transitionTimer.delay !== 4210) throw new Error(`Expected final-loop boundary timer, got ${transitionTimer.delay}.`);\n  await transitionTimer.callback();\n  for (let i = 0; i < 8; i += 1) await new Promise(setImmediate);\n  if (!messages.some(([type, text]) => type === 'log' && text.includes('Current GIF — bamboozled.gif'))) throw new Error('Preloaded GIF did not become current after the boundary.');\n  console.log('Rolling preload verified: next GIF downloads during playback and swaps after final loop.');\n})();\nNODE\ngit diff --check","files":["https://example.test/pages/base.html","pages/base.html","timers.sh"],"category":"read"}
