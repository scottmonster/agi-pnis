{"tool":"exec_command","command":"python3 - <<'PY'\nfrom pathlib import Path\nimport re, difflib\nroot=Path('.')\nworkspace='/home/scott/Documents/siril/tightpsf/'\nexpected={\n 'review_refactor.md':'review_refactor/STATUS.md',\n 'change_review.md':'review_refactor/STATUS.md',\n 'new_review.md':'review_refactor/STATUS.md',\n 'score_changes/score_changes.md':'review_refactor/TODO.md',\n 'score_changes/TODO.md':'review_refactor/TODO.md',\n 'next_change/TODO.md':'review_refactor/TODO.md',\n 'score_changes/changelog.md':'review_refactor/CHANGELOG.md',\n 'next_change/changelog.md':'review_refactor/CHANGELOG.md',\n}\n\ndef norm_source(text):\n    text=text.replace(workspace,'')\n    # Migration appears to strip trailing spaces and final blank tail inconsistently.\n    lines=[ln.rstrip() for ln in text.splitlines()]\n    while lines and lines[-1]=='':\n        lines.pop()\n    return '\\n'.join(lines)\n\ndef norm_dest(text):\n    lines=[ln.rstrip() for ln in text.splitlines()]\n    while lines and lines[-1]=='':\n        lines.pop()\n    return '\\n'.join(lines)\n\nfail=False\nfor src,dst in expected.items():\n    dst_text=(root/dst).read_text()\n    pat=re.compile(r\"^## Migrated Source: `\"+re.escape(src)+r\"`\\n.*?^```markdown\\n(.*?)\\n```\", re.S|re.M)\n    m=pat.search(dst_text)\n    if not m:\n        print(f'MISSING SECTION: {src} in {dst}')\n        fail=True\n        continue\n    s=norm_source((root/src).read_text())\n    d=norm_dest(m.group(1))\n    if s!=d:\n        print(f'DIFF: {src} -> {dst}')\n        for line in difflib.unified_diff(s.splitlines(), d.splitlines(), fromfile=src, tofile=dst, lineterm='', n=3):\n            print(line)\n        fail=True\n    else:\n        print(f'OK: {src} -> {dst} ({len(s.splitlines())} lines)')\nprint('RESULT:', 'FAIL' if fail else 'PASS')\nPY","files":["change_review.md","new_review.md","next_change/TODO.md","next_change/changelog.md","review_refactor.md","review_refactor/CHANGELOG.md","review_refactor/STATUS.md","revie