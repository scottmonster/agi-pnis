{"tool":"exec_command","command":"set -euo pipefail\nprofile_dir=\"$HOME/.config/youtrack-cli/profiles\"\nadmin_profile=\"$profile_dir/admin.env\"\nbase_url=\"$(sed -n 's/^YOUTRACK_BASE_URL=//p' \"$admin_profile\")\"\nadmin_token=\"$(sed -n 's/^YOUTRACK_TOKEN=//p' \"$admin_profile\")\"\ntemp_data_dir=\"/tmp/yt-token-scope-test\"\nmkdir -p \"$temp_data_dir\"\nservices=\"$(curl --silent --show-error --fail -H \"Authorization: Bearer $admin_token\" -H 'Accept: application/json' \"$base_url/hub/api/rest/services?fields=id,name&\\$top=1000\")\"\nyoutrack_service_id=\"$(jq -er '(if type == \"array\" then . else .services end)[] | select(.name == \"YouTrack\") | .id' <<<\"$services\")\"\nfor login in scottmonster project-bootstrap; do\n  target_profile=\"$profile_dir/test-$login.env\"\n  user_json=\"$(curl --silent --show-error --fail -G -H \"Authorization: Bearer $admin_token\" -H 'Accept: application/json' --data-urlencode 'fields=id,login' --data-urlencode \"query=$login\" \"$base_url/api/users\")\"\n  user_id=\"$(jq -er --arg login \"$login\" '.[] | select(.login == $login) | .id' <<<\"$user_json\" | head -n 1)\"\n  ring_id=\"$(curl --silent --show-error --fail -H \"Authorization: Bearer $admin_token\" -H 'Accept: application/json' \"$base_url/api/users/$user_id?fields=ringId\" | jq -er '.ringId')\"\n  token_name=\"${login}-test-yt-only-$(date +%Y%m%d%H%M%S)\"\n  token_payload=\"$(jq -n --arg name \"$token_name\" --arg service \"$youtrack_service_id\" '{name: $name, scope: [{id: $service}]}')\"\n  token_json=\"$(curl --silent --show-error --fail -X POST -H \"Authorization: Bearer $admin_token\" -H 'Accept: application/json' -H 'Content-Type: application/json' --data \"$token_payload\" \"$base_url/hub/api/rest/users/$ring_id/permanenttokens?fields=id,name,token,scope(id,name)\")\"\n  test_token=\"$(jq -er '.token' <<<\"$token_json\")\"\n  XDG_DATA_HOME=\"$temp_data_dir\" yt --config \"$target_profile\" config set YOUTRACK_BASE_URL \"$base_url\" >/dev/null\n  XDG_DATA_HOME=\"$temp_data_dir\" yt --config \"$target_profile\" config set YOUTRACK_USERNAME \"$login\" >/dev/null\n  XDG_DATA_HOME=\"$temp_data_dir\" yt --config \"$target_profile\" config set OUTPUT_FORMAT table >/dev/null\n  XDG_DATA_HOME=\"$temp_data_dir\" yt --config \"$target_profile\" config set YOUTRACK_TOKEN \"$test_token\" >/dev/null\n  chmod 600 \"$target_profile\"\n  printf 'Created %s with token %s (YouTrack scope only).\\n' \"$(basename \"$target_profile\")\" \"$token_name\"\ndone","files":[],"category":"read_range"}
{"tool":"exec_command","command":"set -u\nprofile_dir=\"$HOME/.config/youtrack-cli/profiles\"\ntemp_data_dir=\"/tmp/yt-token-scope-test\"\nfields='id,name,shortName,description,leader(login,fullName),archived,createdBy(login,fullName)'\nfor profile in test-scottmonster test-project-bootstrap; do\n  config=\"$profile_dir/$profile.env\"\n  token=\"$(sed -n 's/^YOUTRACK_TOKEN=//p' \"$config\")\"\n  base_url=\"$(sed -n 's/^YOUTRACK_BASE_URL=//p' \"$config\")\"\n  response_file=\"$(mktemp)\"\n  api_status=\"$(curl --silent --output \"$response_file\" --write-out '%{http_code}' -G -H \"Authorization: Bearer $token\" -H 'Accept: application/json' --data-urlencode \"fields=$fields\" \"$base_url/api/admin/projects\")\"\n  api_identity=\"$(curl --silent --fail -H \"Authorization: Bearer $token\" -H 'Accept: application/json' \"$base_url/api/users/me?fields=login\" 2>/dev/null | jq -r '.login // \"<unknown>\"')\"\n  rm -f \"$response_file\"\n  yt_output=\"$(mktemp)\"\n  XDG_DATA_HOME=\"$temp_data_dir\" PYTHON_KEYRING_BACKEND=keyring.backends.null.Keyring yt --config \"$config\" projects list >\"$yt_output\" 2>&1\n  yt_status=$?\n  printf '\\n[%s]\\n' \"$profile\"\n  printf 'direct API identity: %s\\n' \"$api_identity\"\n  printf 'direct API projects status: %s\\n' \"$api_status\"\n  printf 'yt projects list status (keyring disabled): %s\\n' \"$yt_status\"\n  if [[ \"$yt_status\" -ne 0 ]]; then\n    sed -n '1,20p' \"$yt_output\"\n  fi\n  rm -f \"$yt_output\"\ndone","files":[],"category":"read_range"}
{"tool":"exec_command","command":"profile_dir=\"$HOME/.config/youtrack-cli/profiles\"\nfields='id,name,shortName,description,leader(login,fullName),archived,createdBy(login,fullName)'\nvalue() { sed -n \"s/^$2=//p\" \"$1\" | head -n 1 | sed \"s/^'//;s/'$//\"; }\nfor profile in admin Git-Goblin scottmonster project-bootstrap test-scottmonster test-project-bootstrap; do\n  config=\"$profile_dir/$profile.env\"\n  token=\"$(value \"$config\" YOUTRACK_TOKEN)\"\n  base_url=\"$(value \"$config\" YOUTRACK_BASE_URL)\"\n  response_file=\"$(mktemp)\"\n  status=\"$(curl --silent --output \"$response_file\" --write-out '%{http_code}' -G -H \"Authorization: Bearer $token\" -H 'Accept: application/json' --data-urlencode \"fields=$fields\" \"$base_url/api/admin/projects\")\"\n  identity=\"$(curl --silent --fail -H \"Authorization: Bearer $token\" -H 'Accept: application/json' \"$base_url/api/users/me?fields=login\" 2>/dev/null | jq -r '.login // \"<unknown>\"')\"\n  if [[ \"$status\" == 2* ]]; then\n    count=\"$(jq 'length' \"$response_file\")\"\n    keys=\"$(jq -r 'map(.shortName) | join(\", \")' \"$response_file\")\"\n    printf '%-24s identity=%-18s http=%s projects=%s [%s]\\n' \"$profile\" \"$identity\" \"$status\" \"$count\" \"$keys\"\n  else\n    printf '%-24s identity=%-18s http=%s body=%s\\n' \"$profile\" \"$identity\" \"$status\" \"$(tr '\\n' ' ' < \"$response_file\" | cut -c1-160)\"\n  fi\n  rm -f \"$response_file\"\ndone","files":[],"category":"read_range"}
{"tool":"exec_command","command":"profile_dir=\"$HOME/.config/youtrack-cli/profiles\"\nfields='id,name,shortName,description,leader(login,fullName),archived,createdBy(login,fullName)'\nvalue() { sed -n \"s/^$2=//p\" \"$1\" | head -n 1 | sed \"s/^'//;s/'$//\"; }\nfor profile in admin Git-Goblin scottmonster project-bootstrap test-scottmonster test-project-bootstrap; do\n  config=\"$profile_dir/$profile.env\"\n  token=\"$(value \"$config\" YOUTRACK_TOKEN)\"\n  base_url=\"$(value \"$config\" YOUTRACK_BASE_URL)\"\n  response_file=\"$(mktemp)\"\n  http_code=\"$(curl --silent --output \"$response_file\" --write-out '%{http_code}' -G -H \"Authorization: Bearer $token\" -H 'Accept: application/json' --data-urlencode \"fields=$fields\" \"$base_url/api/admin/projects\")\"\n  identity=\"$(curl --silent --fail -H \"Authorization: Bearer $token\" -H 'Accept: application/json' \"$base_url/api/users/me?fields=login\" 2>/dev/null | jq -r '.login // \"<unknown>\"')\"\n  if [[ \"$http_code\" == 2* ]]; then\n    count=\"$(jq 'length' \"$response_file\")\"\n    keys=\"$(jq -r 'map(.shortName) | join(\", \")' \"$response_file\")\"\n    printf '%-24s identity=%-18s http=%s projects=%s [%s]\\n' \"$profile\" \"$identity\" \"$http_code\" \"$count\" \"$keys\"\n  else\n    printf '%-24s identity=%-18s http=%s body=%s\\n' \"$profile\" \"$identity\" \"$http_code\" \"$(tr '\\n' ' ' < \"$response_file\" | cut -c1-160)\"\n  fi\n  rm -f \"$response_file\"\ndone","files":[],"category":"read_range"}
{"tool":"exec_command","command":"profile_dir=\"$HOME/.config/youtrack-cli/profiles\"\nvalue() { sed -n \"s/^$2=//p\" \"$1\" | head -n 1 | sed \"s/^'//;s/'$//\"; }\nadmin_config=\"$profile_dir/admin.env\"\nadmin_token=\"$(value \"$admin_config\" YOUTRACK_TOKEN)\"\nbase_url=\"$(value \"$admin_config\" YOUTRACK_BASE_URL)\"\napi() { curl --silent --show-error --fail -H \"Authorization: Bearer $admin_token\" -H 'Accept: application/json' \"$base_url/api$1\"; }\nusers=\"$(api '/users?fields=id,login&$top=1000')\"\ngroups=\"$(api '/groups?fields=id,name&$top=1000')\"\nassignments=\"$(api '/assignedRoles?fields=id,role(id,name),holder(id,$type),scope(id,$type,project(id,shortName))&$top=1000')\"\nfor login in Git-Goblin scottmonster project-bootstrap; do\n  user_id=\"$(jq -r --arg login \"$login\" '.[] | select(.login == $login) | .id' <<<\"$users\" | head -n 1)\"\n  printf '\\n[%s]\\n' \"$login\"\n  group_ids='[]'\n  while IFS=$'\\t' read -r group_id group_name; do\n    members=\"$(api \"/groups/$group_id/ownUsers?fields=id&\\$top=1000\")\"\n    if jq -e --arg user \"$user_id\" '.[] | select(.id == $user)' >/dev/null <<<\"$members\"; then\n      printf 'group: %s (%s)\\n' \"$group_name\" \"$group_id\"\n      group_ids=\"$(jq -c --arg id \"$group_id\" '. + [$id]' <<<\"$group_ids\")\"\n    fi\n  done < <(jq -r '.[] | [.id,.name] | @tsv' <<<\"$groups\")\n  jq -r --arg user \"$user_id\" --argjson group_ids \"$group_ids\" '\n    .[] | select(.holder.id == $user or ($group_ids | index(.holder.id))) |\n    \"role: \\(.role.name) | holder=\\(.holder.id) | scope=\\(.scope[\"$type\"])\\(if .scope.project.shortName? then \" (\" + .scope.project.shortName + \")\" else \"\" end)\"\n  ' <<<\"$assignments\"\ndone","files":[".scope.project.sh"],"category":"read_range"}
{"tool":"exec_command","command":"profile_dir=\"$HOME/.config/youtrack-cli/profiles\"\nvalue() { sed -n \"s/^$2=//p\" \"$1\" | head -n 1 | sed \"s/^'//;s/'$//\"; }\nadmin_config=\"$profile_dir/admin.env\"\nadmin_token=\"$(value \"$admin_config\" YOUTRACK_TOKEN)\"\nbase_url=\"$(value \"$admin_config\" YOUTRACK_BASE_URL)\"\nroles_file=\"$(mktemp)\"\ncurl --silent --show-error --fail -H \"Authorization: Bearer $admin_token\" -H 'Accept: application/json' \"$base_url/api/assignedRoles?fields=id,role(id,name),holder(id,\\$type),scope(id,\\$type)&\\$top=1000\" >\"$roles_file\"\nprintf '%s\\n' 'Assignments held by Git Admin (4-1), yt-agents (4-4), and yt-personal-admins (4-3):'\njq -r '.[] | select(.holder.id == \"4-1\" or .holder.id == \"4-4\" or .holder.id == \"4-3\") | \"holder=\\(.holder.id) role=\\(.role.name) scope=\\(.scope[\"$type\"])\"' \"$roles_file\"\nrm -f \"$roles_file\"","files":[],"category":"read_range"}
