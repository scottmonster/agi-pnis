{"tool":"exec_command","command":"profile_dir=\"$HOME/.config/youtrack-cli/profiles\"\nadmin_token=\"$(sed -n 's/^YOUTRACK_TOKEN=//p' \"$profile_dir/admin.env\")\"\nbase_url=\"$(sed -n 's/^YOUTRACK_BASE_URL=//p' \"$profile_dir/admin.env\")\"\nrequest() { curl --silent --show-error --fail -H \"Authorization: Bearer $admin_token\" -H 'Accept: application/json' \"$base_url/api$1\"; }\nusers=\"$(request '/users?fields=id,login&$top=1000')\"\nroles=\"$(request '/assignedRoles?fields=id,role(id,name),holder(id,$type),scope(id,$type)&$top=1000')\"\ngroups=\"$(request '/groups?fields=id,name&$top=1000')\"\nfor login in admin Git-Goblin scottmonster project-bootstrap; do\n  user_id=\"$(jq -r --arg login \"$login\" '.[] | select(.login == $login) | .id' <<<\"$users\" | head -n1)\"\n  printf '\\n[%s] id=%s\\n' \"$login\" \"${user_id:-not found}\"\n  jq -r --arg user \"$user_id\" '.[] | select(.holder.id == $user) | \"direct: \\(.role.name) [\\(.scope[\"$type\"])]\"' <<<\"$roles\"\ndone\nfor group_name in yt-personal-admins yt-agents; do\n  group_id=\"$(jq -r --arg group \"$group_name\" '.[] | select(.name == $group) | .id' <<<\"$groups\" | head -n1)\"\n  printf '\\n[%s] id=%s\\n' \"$group_name\" \"${group_id:-not found}\"\n  if [[ -n \"$group_id\" ]]; then\n    members=\"$(request \"/groups/$group_id/ownUsers?fields=id,login&\\$top=1000\")\"\n    printf 'members: '\n    jq -r 'if length == 0 then \"<none>\" else map(.login) | join(\", \") end' <<<\"$members\"\n    jq -r --arg group \"$group_id\" '.[] | select(.holder.id == $group) | \"role: \\(.role.name) [\\(.scope[\"$type\"])]\"' <<<\"$roles\"\n  fi\ndone","files":[],"category":"read_range"}
