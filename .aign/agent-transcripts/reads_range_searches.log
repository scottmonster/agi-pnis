{"tool":"exec_command","command":"printf '%s\\n' '--- compare full vs ccusage saved reports ---'; cmp -s usage/full_usage.json usage/ccusage/post_change.json; echo \"full_eq_post=$?\"; cmp -s usage/full_usage.json usage/ccusage/pre_change.json; echo \"full_eq_pre=$?\"; jq -n --slurpfile full usage/full_usage.json --slurpfile post usage/ccusage/post_change.json --slurpfile pre usage/ccusage/pre_change.json '\n  def bydate($x): reduce $x[0].daily[] as $d ({}; .[$d.period]=$d);\n  (bydate($full)) as $f | (bydate($post)) as $p | (bydate($pre)) as $r |\n  {\n    full_days: ($f|length), post_days: ($p|length), pre_days: ($r|length),\n    full_only: ([$f|keys[] | select($p[.] == null)]),\n    post_only: ([$p|keys[] | select($f[.] == null)]),\n    shared_identical: ([$f|keys[] | select($p[.] != null and $f[.] == $p[.])] | length),\n    shared_different: ([$f|keys[] | select($p[.] != null and $f[.] != $p[.])]),\n    first_full: $full[0].daily[0], first_post: $post[0].daily[0]\n  }\n' ; printf '%s\\n' '--- compare selected values ---'; jq -n --slurpfile full usage/full_usage.json --slurpfile post usage/ccusage/post_change.json '\n  ($full[0].daily | map({key:.period,value:.}) | from_entries) as $f | ($post[0].daily | map({key:.period,value:.}) | from_entries) as $p |\n  [$f|keys[] | select($p[.] != null and $f[.] != $p[.]) | {date:.,full:$f[.],post:$p[.]}] | .[0:3]\n'; printf '%s\\n' '--- saved report provenance ---'; stat -c '%y %n' usage/ccusage/pre_change.json usage/ccusage/post_change.json; find usage/ccusage -maxdepth 2 -type f \\( -name '*.json' -o -name '*.md' \\) -newermt '2026-06-20 18:00' -printf '%TY-%Tm-%Td %TT %p\\n' | sort | head -80","files":["usage/ccusage/post_change.json","usage/ccusage/pre_change.json","usage/full_usage.json"],"category":"read_range"}
