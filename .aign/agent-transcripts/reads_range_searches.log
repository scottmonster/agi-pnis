{"tool":"exec_command","command":"node <<'NODE'\nconst fs = require('fs');\nconst vm = require('vm');\nconst html = fs.readFileSync('pages/base.html', 'utf8');\nconst script = html.match(/<script>([\\s\\S]*?)<\\/script>/)[1];\nconst messages = [];\nconst timers = [];\nfunction makeImage() {\n  const listeners = {};\n  const image = {\n    hidden: true,\n    addEventListener(type, listener) { listeners[type] = listener; },\n  };\n  Object.defineProperty(image, 'src', {\n    set(value) {\n      this.currentSrc = String(value);\n      queueMicrotask(() => listeners.load?.());\n    },\n  });\n  return image;\n}\nconst images = {\n  'random-gif': makeImage(),\n  'rick-roll-background': makeImage(),\n};\nconst context = {\n  URL, Uint8Array, Math, JSON, Promise,\n  location: { href: 'https://example.test/pages/base.html' },\n  document: { getElementById: (id) => images[id] },\n  localStorage: { getItem: () => JSON.stringify(['rickroll-roll.gif', 'bamboozled.gif']), setItem: () => {} },\n  window: { setTimeout: (callback, delay) => timers.push({ callback, delay }) },\n  fetch: async (url) => {\n    const filename = new URL(url).pathname.split('/').pop();\n    const bytes = fs.readFileSync(`assets/${filename}`);\n    return { ok: true, arrayBuffer: async () => bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength) };\n  },\n  console: {\n    log: (...args) => messages.push(['log', args.join(' ')]),\n    warn: (...args) => messages.push(['warn', args.join(' ')]),\n    count: (label) => messages.push(['count', label]),\n  },\n};\nvm.runInNewContext(script, context);\n(async () => {\n  for (let i = 0; i < 10; i += 1) await new Promise(setImmediate);\n  if (images['rick-roll-background'].hidden) throw new Error('Background was not enabled.');\n  if (!images['rick-roll-background'].currentSrc.endsWith('/rickroll-roll.gif')) throw new Error('Incorrect background GIF.');\n  if (images['random-gif'].currentSrc.endsWith('/rickroll-roll.gif')) throw new Error('Rickroll remained in the foreground queue.');\n  if (!images['random-gif'].currentSrc.endsWith('/bamboozled.gif')) throw new Error('Saved queue was not filtered to the replacement GIF.');\n  if (!messages.some(([type, text]) => type === 'count' && text === 'start')) throw new Error('Foreground playlist did not start.');\n  if (timers.length !== 1) throw new Error('Foreground transition was not scheduled.');\n  console.log('Rickroll background and foreground-queue exclusion verified.');\n})();\nNODE\ngit diff --check","files":["https://example.test/pages/base.html","pages/base.html"],"category":"read"}
