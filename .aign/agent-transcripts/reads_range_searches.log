{"tool":"exec_command","command":"{\nprintf '%s\\n' \\\n'#!/usr/bin/env bash' \\\n'# Unified YouTrack instance and project bootstrap.' \\\n'set -euo pipefail' \\\n''\n# Shared helpers formerly in lib.sh. Drop the unused *delete_if_exists wrappers.\nsed -e '1,4d' -e '146,148d' -e '220,222d' youtrack/scripts/lib.sh\nprintf '%s\\n' \\\n'' \\\n'usage() {' \\\n\"  cat <<'EOF'\" \\\n'Usage: youtrack-bootstrap.sh [--environment|--env|-e] [options]' \\\n'' \\\n'Without a mode flag, creates or reuses the YouTrack Default project for the selected project root.' \\\n'' \\\n'Project options (default mode):' \\\n'  --profile FILE       Project Bootstrap yt-cli profile' \\\n'  --project-id ID      Existing YouTrack database project ID' \\\n'  --project-root DIR   Directory to bootstrap' \\\n'' \\\n'Environment options (require --environment, --env, or -e):' \\\n'  --start-env          Create a private youtrack-bootstrap.env template and exit' \\\n'  --remove-api-tokens  Revoke only bootstrap-managed permanent tokens and exit' \\\n'  --profile-dir DIR    Directory for generated yt-cli profiles' \\\n'' \\\n'Common options: --dry-run, --json, --help' \\\n'EOF' \\\n'}' \\\n'' \\\n'MODE=project' \\\n'JSON_OUTPUT=0' \\\n'PROJECT_OPTIONS_USED=0' \\\n'ENVIRONMENT_OPTIONS_USED=0' \\\n'PROJECT_PROFILE_OPTION=\"\"' \\\n'PROJECT_ID_OPTION=\"\"' \\\n'PROJECT_ROOT_OPTION=\"\"' \\\n'ENVIRONMENT_PROFILE_DIR_OPTION=\"\"' \\\n'ENVIRONMENT_START_ENV=0' \\\n'ENVIRONMENT_REMOVE_API_TOKENS=0' \\\n'' \\\n'while [[ $# -gt 0 ]]; do' \\\n'  case \"$1\" in' \\\n'    --environment|--env|-e) MODE=environment ;;' \\\n'    --profile)' \\\n'      [[ $# -ge 2 ]] || die \"--profile requires a file\"' \\\n'      PROJECT_OPTIONS_USED=1; PROJECT_PROFILE_OPTION=\"$2\"; shift' \\\n'      ;;' \\\n'    --project-id)' \\\n'      [[ $# -ge 2 ]] || die \"--project-id requires a YouTrack database project ID (for example, 0-5)\"' \\\n'      PROJECT_OPTIONS_USED=1; PROJECT_ID_OPTION=\"$2\"; shift' \\\n'      ;;' \\\n'    --project-root)' \\\n'      [[ $# -ge 2 ]] || die \"--project-root requires a directory\"' \\\n'      PROJECT_OPTIONS_USED=1; PROJECT_ROOT_OPTION=\"$2\"; shift' \\\n'      ;;' \\\n'    --start-env) ENVIRONMENT_OPTIONS_USED=1; ENVIRONMENT_START_ENV=1 ;;' \\\n'    --remove-api-tokens) ENVIRONMENT_OPTIONS_USED=1; ENVIRONMENT_REMOVE_API_TOKENS=1 ;;' \\\n'    --profile-dir)' \\\n'      [[ $# -ge 2 ]] || die \"--profile-dir requires a directory\"' \\\n'      ENVIRONMENT_OPTIONS_USED=1; ENVIRONMENT_PROFILE_DIR_OPTION=\"$2\"; shift' \\\n'      ;;' \\\n'    --dry-run) YT_DRY_RUN=1 ;;' \\\n'    --json) JSON_OUTPUT=1 ;;' \\\n'    -h|--help) usage; exit 0 ;;' \\\n'    *) die \"Unknown argument: $1\" ;;' \\\n'  esac' \\\n'  shift' \\\n'done' \\\n'' \\\n'if [[ \"$MODE\" == \"environment\" && \"$PROJECT_OPTIONS_USED\" == \"1\" ]]; then' \\\n'  die \"Project options cannot be used with --environment.\"' \\\n'fi' \\\n'if [[ \"$MODE\" == \"project\" && \"$ENVIRONMENT_OPTIONS_USED\" == \"1\" ]]; then' \\\n'  die \"Environment options require --environment, --env, or -e.\"' \\\n'fi' \\\n'' \\\n'run_project_mode() {' \\\n'  YT_CLI_CONFIG_DIR=\"${XDG_CONFIG_HOME:-$HOME/.config}/youtrack-cli\"' \\\n'  PROJECT_STATE_DIR=\"${YOUTRACK_PROJECT_STATE_DIR:-$YT_CLI_CONFIG_DIR/projects}\"' \\\n'  ENABLE_VCS=\"${ENABLE_VCS:-0}\"' \\\n'  PROFILE_PATH=\"${YOUTRACK_PROFILE:-}\"' \\\n'  PROFILE_POINTER=\"${YOUTRACK_PROJECT_BOOTSTRAP_PROFILE_FILE:-$YT_CLI_CONFIG_DIR/project-bootstrap-profile}\"' \\\n'  PROJECT_OVERRIDE_ID=\"${YOUTRACK_PROJECT_ID:-}\"' \\\n'  PROJECT_ROOT_INPUT=\"${YOUTRACK_PROJECT_ROOT:-}\"' \\\n'  USING_PROFILE_POINTER=0' \\\n'  if [[ -z \"$PROFILE_PATH\" ]]; then' \\\n'    PROFILE_PATH=\"$(read_env_value \"$PROFILE_POINTER\" YOUTRACK_PROFILE)\"' \\\n'    [[ -n \"$PROFILE_PATH\" ]] && USING_PROFILE_POINTER=1' \\\n'  fi' \\\n'  if [[ -z \"$PROFILE_PATH\" ]]; then' \\\n'    PROFILE_PATH=\"$YT_CLI_CONFIG_DIR/profile/${YOUTRACK_PROJECT_BOOTSTRAP_USERNAME:-project-bootstrap}.env\"' \\\n'  fi' \\\n'  [[ -n \"$PROJECT_PROFILE_OPTION\" ]] && PROFILE_PATH=\"$PROJECT_PROFILE_OPTION\"' \\\n'  [[ -n \"$PROJECT_ID_OPTION\" ]] && PROJECT_OVERRIDE_ID=\"$PROJECT_ID_OPTION\"' \\\n'  [[ -n \"$PROJECT_ROOT_OPTION\" ]] && PROJECT_ROOT_INPUT=\"$PROJECT_ROOT_OPTION\"'\nsed -n '86,$p' youtrack/scripts/project-level-bootstrap.sh | sed -e 's/run-once-bootstrap\\.sh/youtrack-bootstrap.sh --environment/g' -e 's/project-level-bootstrap\\.sh/youtrack-bootstrap.sh/g'\nprintf '%s\\n' '}' '' 'run_environment_mode() {' '  PROFILE_DIR=\"${ENVIRONMENT_PROFILE_DIR_OPTION:-${XDG_CONFIG_HOME:-$HOME/.config}/youtrack-cli/profiles}\"' '  START_ENV=\"$ENVIRONMENT_START_ENV\"' '  REMOVE_API_TOKENS=\"$ENVIRONMENT_REMOVE_API_TOKENS\"'\nsed -n '71,$p' youtrack/scripts/run-once-bootstrap.sh | sed -e 's/run-once-bootstrap\\.sh/youtrack-bootstrap.sh --environment/g' -e 's/project-level-bootstrap\\.sh/youtrack-bootstrap.sh/g'\nprintf '%s\\n' '}' '' 'if [[ \"$MODE\" == \"environment\" ]]; then' '  run_environment_mode' 'else' '  run_project_mode' 'fi'\n} > youtrack/scripts/youtrack-bootstrap.sh\nchmod 775 youtrack/scripts/youtrack-bootstrap.sh\nbash -n youtrack/scripts/youtrack-bootstrap.sh","files":[".sh/youtrack-bootstrap.sh","lib.sh","youtrack-bootstrap.sh","youtrack/scripts/lib.sh","youtrack/scripts/project-level-bootstrap.sh","youtrack/scripts/run-once-bootstrap.sh","youtrack/scripts/youtrack-bootstrap.sh"],"category":"read_range"}
