'blob:')) throw new Error('Current GIF was not supplied from a preloaded blob.');\n  if (!fetched.includes('bamboozled.gif')) throw new Error('Next GIF was not preloaded during current playback.');\n  const firstLoopTimer = timers.shift();\n  if (firstLoopTimer.delay !== 4210) throw new Error('Incorrect current-loop timing.');\n  await firstLoopTimer.callback();\n  const finalLoopTimer = timers.shift();\n  if (finalLoopTimer.delay !== 4210) throw new Error('Final-loop boundary was not scheduled.');\n  await finalLoopTimer.callback();\n  for (let i = 0; i < 8; i += 1) await new Promise(setImmediate);\n  if (timers.shift().delay !== 6040) throw new Error('Preloaded next GIF did not become the active GIF.');\n  console.log('Rolling preload verified: next GIF downloads during playback and swaps at the final-loop boundary.');\n})();\nNODE\ngit diff --check","files":["https://example.test/pages/base.html","pages/base.html","timers.sh"],"category":"read"}
