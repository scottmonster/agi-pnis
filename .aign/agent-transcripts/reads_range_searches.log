{"tool":"exec_command","command":"sed -n '1,180p' notes/slight_issue.md; python3 - <<'PY'\nfrom pathlib import Path\nimport re\nroot=Path('.')\nfiles=list(root.rglob('*.md'))\nmissing=[]\nfor source in files:\n    text=source.read_text()\n    for raw in re.findall(r'(?<!!)\\[[^]]*\\]\\(([^)]+)\\)', text):\n        dest=raw.split('#',1)[0].strip().strip('<>')\n        if not dest or '://' in dest or dest.startswith('mailto:'):\n            continue\n        target=(source.parent/dest).resolve()\n        if not target.exists():\n            missing.append((source.as_posix(), raw))\nprint(f'Markdown files checked: {len(files)}')\nprint(f'Resolvable relative links checked: {sum(len(re.findall(r\"(?<!!)\\\\[[^]]*\\\\]\\\\(([^)]+)\\\\)\", p.read_text())) for p in files)}')\nif missing:\n    for source, raw in missing:\n        print(f'MISSING {source}: {raw}')\nelse:\n    print('Missing relative targets: none')\nrequired=['Purpose and Relationship','Entry Conditions','Core Workflow','Required State Updates','Required Evidence and Outputs','Exit Criteria and Allowed Transitions','Tailoring','Related Specifications']\nplaybooks=sorted(root.glob('01-lifecycle/phases/*/playbook.md'))\nprint(f'Playbooks found: {len(playbooks)}')\nfor p in playbooks:\n    headings=re.findall(r'^## (.+)$',p.read_text(),re.M)\n    issue=[h for h in required if h not in headings]\n    print(f'{p.as_posix()}: '+('template headings present' if not issue else 'missing '+', '.join(issue)))\nPY","files":["notes/slight_issue.md","playbook.md"],"category":"read_range"}
