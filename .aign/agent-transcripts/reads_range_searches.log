{"tool":"exec_command","command":"node <<'NODE'\nconst fs = require('fs');\nconst vm = require('vm');\nconst html = fs.readFileSync('pages/base.html', 'utf8');\nconst script = html.match(/<script>([\\s\\S]*?)<\\/script>/)[1];\nconst messages = [];\nconst timers = [];\nconst fetched = [];\nfunction makeImage() {\n  const listeners = new Map();\n  const image = {\n    hidden: true,\n    addEventListener(type, callback, options = {}) {\n      const callbacks = listeners.get(type) || [];\n      callbacks.push({ callback, once: options.once });\n      listeners.set(type, callbacks);\n    },\n  };\n  Object.defineProperty(image, 'src', {\n    set(value) {\n      this.currentSrc = String(value);\n      queueMicrotask(() => {\n        const callbacks = listeners.get('load') || [];\n        listeners.set('load', callbacks.filter((entry) => !entry.once));\n        callbacks.forEach((entry) => entry.callback());\n      });\n    },\n  });\n  return image;\n}\nconst images = { 'random-gif': makeImage(), 'rick-roll-background': makeImage() };\nconst context = {\n  URL, Blob, Uint8Array, Math, JSON, Promise, Image: makeImage,\n  location: { href: 'https://example.test/pages/base.html' },\n  document: { getElementById: (id) => images[id] },\n  localStorage: { getItem: () => JSON.stringify(['bamboozled.gif', 'gotcha-b.gif']), setItem: () => {} },\n  window: { setTimeout: (callback, delay) => timers.push({ callback, delay }) },\n  fetch: async (url) => {\n    const filename = new URL(url).pathname.split('/').pop();\n    fetched.push(filename);\n    const bytes = fs.readFileSync(`assets/${filename}`);\n    return { ok: true, arrayBuffer: async () => bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength) };\n  },\n  console: {\n    log: (...args) => messages.push(['log', args.join(' ')]),\n    warn: (...args) => messages.push(['warn', args.join(' ')]),\n    count: (label) => messages.push(['count', label]),\n  },\n};\nvm.runInNewContext(script, context);\n(async () => {\n  const initialDelay = timers.shift();\n  if (initialDelay.delay !== 5000) throw new Error('Expected initial placeholder delay.');\n  await initialDelay.callback();\n  for (let i = 0; i < 12; i += 1) await new Promise(setImmediate);\n  if (!images['random-gif'].currentSrc.startsWith('blob:')) throw new Error('Current GIF was not supplied from a preloaded blob.');\n  if (!fetched.includes('bamboozled.gif')) throw new Error('Next GIF was not preloaded while the current GIF played.');\n  const loopTimer = timers.shift();\n  if (loopTimer.delay !== 4210) throw new Error(`Expected first Gotcha loop timer, got ${loopTimer.delay}.`);\n  await loopTimer.callback();\n  const transitionTimer = timers.shift();\n  if (transitionTimer.delay !== 4210) throw new Error(`Expected final-loop boundary timer, got ${transitionTimer.delay}.`);\n  await transitionTimer.callback();\n  for (let i = 0; i < 8; i += 1) await new Promise(setImmediate);\n  if (!messages.some(([type, text]) => type === 'log' && text.includes('Current GIF — bamboozled.gif'))) throw new Error('Preloaded GIF did not become current after the boundary.');\n  console.log('Rolling preload verified: next GIF downloads during playback and swaps after final loop.');\n})();\nNODE\ngit diff --check","files":["https://example.test/pages/base.html","pages/base.html","timers.sh"],"category":"read"}
