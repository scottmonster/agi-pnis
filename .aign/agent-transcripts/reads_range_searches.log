{"tool":"exec_command","command":"python3 - <<'PY'\nfrom pathlib import Path\nimport re\nroot = Path('/home/scott/Documents/agi-pnis/gov-lab/observe')\nindex = (root / 'failure_index.md').read_text()\ncatalogue = (root / 'large_list.md').read_text()\nfamily_re = re.compile(r'^### (\\d+\\.\\d+) ([A-Z]+-[A-Z]+) — (.+)$', re.M)\npattern_re = re.compile(r'^- \\*\\*([A-Z]+-[A-Z]+-\\d{3}) (\\[[A-Z/]+\\]) (.+?)(?::\\*\\*|\\.\\*\\*)', re.M)\nanchor_re = re.compile(r'^<a id=\"([a-z-]+)\"></a>$', re.M)\nindex_families = family_re.findall(index)\ncatalogue_families = family_re.findall(catalogue)\npatterns = pattern_re.findall(catalogue)\nassert index_families == catalogue_families, 'family hierarchies differ'\nassert len(index_families) == len(set(x[1] for x in index_families)), 'duplicate family ID'\nassert len(patterns) == len(set(x[0] for x in patterns)), 'duplicate pattern ID'\nassert len(patterns) >= 262, f'expected at least 262 patterns, found {len(patterns)}'\nassert anchor_re.findall(index) == anchor_re.findall(catalogue), 'anchors differ'\nassert len(anchor_re.findall(index)) == len(set(anchor_re.findall(index))), 'duplicate anchors'\nfor _, code, _ in index_families:\n    anchor = code.lower()\n    assert f'large_list.md#{anchor}' in index, f'missing catalogue link {code}'\n    assert f'failure_index.md#{anchor}' in catalogue, f'missing index link {code}'\nfor line_no, line in enumerate(index.splitlines(), 1):\n    assert not line.endswith((' ', '\\t')), f'index trailing whitespace at {line_no}'\nfor line_no, line in enumerate(catalogue.splitlines(), 1):\n    assert not line.endswith((' ', '\\t')), f'catalogue trailing whitespace at {line_no}'\nprint(f'families={len(index_families)} patterns={len(patterns)} anchors={len(anchor_re.findall(index))}')\nprint('hierarchy=matched ids=unique links=complete whitespace=clean')\nPY\nrg -n '^## [1-8]\\. |^### [2-6]\\.' observe/failure_index.md observe/large_list.md | tail -80\nsed -n '660,780p' observe/large_list.md","files":["