{"tool":"exec_command","command":"sed -n '340,440p' scripts/process/00combined.py && python3 - <<'PY'\nfrom pathlib import Path\nimport importlib.util\nimport sys\nimport tempfile\nimport types\n\nsys.modules['sirilpy'] = types.SimpleNamespace(SirilInterface=object)\n\nspec = importlib.util.spec_from_file_location('combined', 'scripts/process/00combined.py')\nmod = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(mod)\n\nclass FakeSiril:\n    def __init__(self, root):\n        self.root = str(root)\n        self.commands = []\n        self.logs = []\n\n    def get_siril_wd(self):\n        return self.root\n\n    def cmd(self, *args):\n        self.commands.append(args)\n\n    def log(self, message):\n        self.logs.append(message)\n\nwith tempfile.TemporaryDirectory() as tmp:\n    root = Path(tmp)\n    (root / 'lights').mkdir()\n    (root / 'process').mkdir()\n    (root / 'master-flat.fit').touch()\n\n    siril = FakeSiril(root)\n    mod.run_pipeline(siril)\n    commands = siril.commands\n    assert ('link', 'light', '-out=../process') in commands\n    assert ('convert', 'light_debayer', '-debayer', '-out=../process') in commands\n    assert ('calibrate', 'light', '-flat=../master-flat.fit', '-cfa', '-equalize_cfa', '-all', '-prefix=cal_') in commands\n    assert ('calibrate_single', '../master-flat.fit', '-debayer', '-prefix=debayered_') in commands\n    assert ('setfindstar', '-radius=10', '-sigma=0.75', '-roundness=0.5', '-relax=on') in commands\n    assert ('seqapplyreg', 'cal_light_debayer', '-prefix=reg_', '-scale=1.0', '-framing=min') in commands\n    print('missing-marker run commands:', len(commands))\n\nwith tempfile.TemporaryDirectory() as tmp:\n    root = Path(tmp)\n    (root / 'lights').mkdir()\n    (root / 'process').mkdir()\n    (root / 'master-flat.fit').touch()\n    for stages in (mod.CONVERSION_STAGES, mod.CALIBRATION_STAGES, mod.REGISTRATION_STAGES):\n        for stage in stages:\n            for marker in mod.stage_marker_paths(root, stage):\n                marker.parent.mkdir(parents=True, exist_ok=True)\n                marker.touch()\n\n    siril = FakeSiril(root)\n    mod.run_pipeline(siril)\n    processing_commands = [cmd for cmd in siril.commands if cmd[0] not in {'requires', 'cd'}]\n    assert processing_commands == []\n    assert any('all registration outputs present' in msg for msg in siril.logs)\n    print('all-marker run processing commands:', len(processing_commands))\nPY","files":["scripts/process/00combined.py"],"category":"read_range"}
