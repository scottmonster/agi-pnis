{"tool":"exec_command","command":"python3 - <<'PY'\nimport importlib.util\nimport sys\nimport tempfile\nfrom pathlib import Path\n\nspec = importlib.util.spec_from_file_location(\"md_new_runner\", \"test_md-new.py\")\nrunner = importlib.util.module_from_spec(spec)\nassert spec.loader is not None\nsys.modules[spec.name] = runner\nspec.loader.exec_module(runner)\n\nwith tempfile.TemporaryDirectory() as directory:\n    root = Path(directory)\n    corpus = root / \"tests\"\n    source = corpus / \"nested\" / \"sample.md\"\n    source.parent.mkdir(parents=True)\n    source.write_text(\"# Sample\\n\\nOriginal content.\\n\", encoding=\"utf-8\")\n    run = root / \"test-runs\" / \"check\"\n    input_file = run / \"rounds\" / \"round-001\" / \"inputs\" / \"nested\" / \"sample.md\"\n    output_low = run / \"rounds\" / \"round-001\" / \"outputs\" / \"low\" / \"nested\" / \"sample.md\"\n    output_high = run / \"rounds\" / \"round-001\" / \"outputs\" / \"high\" / \"nested\" / \"sample.md\"\n    for path, text in ((input_file, source.read_text()), (output_low, \"# Sample\\n\\nOriginal content.\\n\"), (output_high, \"# Sample\\n\")):\n        path.parent.mkdir(parents=True, exist_ok=True)\n        path.write_text(text, encoding=\"utf-8\")\n    for variant, outcome in ((\"low\", \"PASS\"), (\"high\", \"FAIL\")):\n        audit = run / \"results\" / \"audits\" / \"round-001\" / variant / \"nested\" / \"sample.md.audit.md\"\n        audit.parent.mkdir(parents=True, exist_ok=True)\n        audit.write_text(f\"**Outcome:** {outcome}\\n\\n## Findings\\n\\nNo material findings.\\n\", encoding=\"utf-8\")\n    timing = runner.TimingLog(run / \"results\" / \"timing.md\", \"2026-01-01T00:00:00Z\")\n    timing.elapsed_seconds = 1.0\n    timing.write()\n    report = runner.write_report(run, corpus, (source,), 1, timing)\n    text = report.read_text(encoding=\"utf-8\")\n    assert \"nested/sample.md\" in text\n    assert \"PASS\" in text and \"FAIL\" in text\nprint(\"static report check passed\")\nPY\nrg -n -- 'new_prompt|mine-comp|resynth|--tests-root|--resume|--variant|model|snapshot|repair' test_md-new.py || true\nfind . -maxdepth 2 -type d -name '__pycache__' -print","files":["nested/sample.md","sample.md","sample.md.audit.md","test_md-new.py","timing.md"],"category":"search"}
