y}')\nmeta = yaml.safe_load((root / 'agents/openai.yaml').read_text())\nif meta.get('policy', {}).get('allow_implicit_invocation') is not False:\n    errors.append('agents/openai.yaml: implicit invocation policy is not false')\nif errors:\n    print('\\n'.join(errors))\n    raise SystemExit(1)\nprint('static checks passed: frontmatter, invocation policy, links, anchors, and table alignment')\nPY\nprintf '\\n--- stale active references ---\\n'\nrg -n 'rules/(markdown|material)\\.md|audit-report|coverage-ledger|resynth|material-audit' skills/md || true\nprintf '\\n--- prohibited punctuation ---\\n'\nrg -n '[—–]' skills/md || true\nprintf '\\n--- likely unfinished markers ---\\n'\nrg -n -i 'todo|fixme|tbd|placeholder|\\.\\.\\.' skills/md || true\nprintf '\\n--- common spelling regressions ---\\n'\nrg -n -i 'atleast|effected audit|recommed|proritiz|recieve|seperate' skills/md || true","files":["SKILL.md","agents/openai.yaml"],"category":"search"}
